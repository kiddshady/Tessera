{
  "name": "tessera",
  "productName": "Tessera",
  "version": "0.2.1",
  "description": "Autenticador TOTP de escritorio: los códigos de doble factor, leídos del QR en pantalla, con las claves cifradas en tu disco.",
  "main": "main.cjs",
  "author": "Kidd Shady · Umbrovex Systems <umbrovex@proton.me>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/tokens.test.mjs && node test/store.test.mjs && node test/format.test.mjs && node test/totp.test.mjs && node test/actualizador.test.mjs",
    "smoke": "electron test/smoke.test.cjs",
    "icon": "python tools/icon.py",
    "build": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^25.1.8",
    "qrcode": "^1.5.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jsqr": "^1.4.0"
  },
  "type": "module",
  "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
  "homepage": "https://github.com/kiddshady/Tessera",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiddshady/Tessera.git"
  },
  "build": {
    "appId": "com.umbrovex.tessera",
    "productName": "Tessera",
    "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "kiddshady",
      "repo": "Tessera",
      "releaseType": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "LICENSE",
      "NOTICE",
      "package.json",
      "!data/**",
      "!test/**",
      "!docs/**",
      "!tools/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
